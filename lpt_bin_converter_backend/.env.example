# Optional configuration for lpt_bin_converter_backend

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated). Use "*" to allow all.
LPT_API_CORS_ORIGINS=*

# Restrict filesystem paths for /convert and /convert/advanced.
# If unset/empty, no allow-root restriction is applied (not recommended for untrusted clients).
# LPT_API_ALLOWED_INPUT_ROOT=/data/input
# LPT_API_ALLOWED_OUTPUT_ROOT=/data/output

# Upload constraints
# Default is 50MB (52428800).
LPT_API_MAX_UPLOAD_BYTES=52428800

# Temp directory for /convert/upload intermediate files (defaults to system temp).
# LPT_API_TEMP_DIR=/tmp/lpt-converter

# Server bind settings for `python -m src.api`
HOST=0.0.0.0
PORT=3001
